datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// PostingCategory (string): BASEBALL_OPS | BASEBALL_ANALYTICS | BASEBALL_RND | DATA_SCIENCE | OTHER
// ApplicationStage (string): FOUND | REVIEWING | APPLIED | INTERVIEW | OFFER | REJECTED | WITHDRAWN
// SQLite has no native enum support in Prisma, so these are validated in the API layer (zod) instead.

model Source {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String   // "greenhouse" | "lever" | "workday" | "team_page" | "manual"
  config    String?  // JSON string: selectors, board tokens, base URLs, etc.
  createdAt DateTime @default(now())
  postings  Posting[]
}

model Posting {
  id            String   @id @default(cuid())
  sourceId      String
  source        Source   @relation(fields: [sourceId], references: [id])
  externalId    String   // id/url fragment from the source, used for dedup
  title         String
  organization  String
  location      String?
  category      String   @default("OTHER")
  url           String
  description   String?
  postedAt      DateTime?
  discoveredAt  DateTime @default(now())
  applications  Application[]

  // Active/inactive tracking (scrapers/src/ingest.ts's closing pass, scoped per sourceId+organization
  // since one Source row is shared across every org an adapter covers).
  lastSeenAt    DateTime @default(now())
  closedAt      DateTime?
  missedRuns    Int      @default(0)

  // Cross-source duplicate flagging (scrapers/src/dedupe.ts) — a fuzzy title match against an
  // existing posting from the same org is inserted as its own row and linked here rather than
  // silently skipped, so it's visible and reviewable instead of invisibly suppressed.
  possibleDuplicateOfId String?
  possibleDuplicateOf   Posting?  @relation("PostingDuplicate", fields: [possibleDuplicateOfId], references: [id], onDelete: SetNull)
  duplicateCandidates   Posting[] @relation("PostingDuplicate")
  duplicateRejected     Boolean   @default(false)

  @@unique([sourceId, externalId])
}

model Application {
  id          String            @id @default(cuid())
  postingId   String
  posting     Posting           @relation(fields: [postingId], references: [id])
  stage       String            @default("FOUND")
  order       Int               @default(0) // position within its stage column, for Kanban drag-reorder
  resumeDocId String?
  resumeDoc   Document?         @relation("ResumeDoc", fields: [resumeDocId], references: [id])
  coverDocId  String?
  coverDoc    Document?         @relation("CoverDoc", fields: [coverDocId], references: [id])
  notes       String?
  appliedAt   DateTime?
  updatedAt   DateTime          @updatedAt
  createdAt   DateTime          @default(now())
}

model Document {
  id                    String   @id @default(cuid())
  kind                  String   // "resume" | "cover_letter"
  label                 String
  filePath              String
  isBaseTemplate        Boolean  @default(false)
  generatedFromBulletIds String? // comma-separated ResumeBullet ids used to draft this document
  toneId                String?
  tone                  TonePreset? @relation(fields: [toneId], references: [id])
  createdAt             DateTime @default(now())
  resumeFor             Application[] @relation("ResumeDoc")
  coverFor              Application[] @relation("CoverDoc")
}

// Reusable experience bullets the tailoring skill draws from instead of inventing
// phrasing per application. `category` matches PostingCategory loosely (e.g.
// "baseball_ops", "data_science", "general") to narrow candidates for a given posting.
model ResumeBullet {
  id       String  @id @default(cuid())
  category String
  text     String
  tags     String? // comma-separated free-text tags
  isActive Boolean @default(true)
}

// Named tone/voice guidance the tailoring skill picks based on posting category or
// an OrgProfile override, instead of inferring tone from a single prior example letter.
model TonePreset {
  id        String   @id @default(cuid())
  name      String   @unique
  guidance  String   // freeform description of voice/structure to follow
  isDefault Boolean  @default(false)
  documents Document[]
  orgs      OrgProfile[]
}

// Optional per-organization memory so a second application to the same org doesn't
// start from zero — notes on culture/prior interactions, and an optional tone override.
model OrgProfile {
  id               String      @id @default(cuid())
  organizationName String      @unique
  notes            String?
  preferredToneId  String?
  preferredTone    TonePreset? @relation(fields: [preferredToneId], references: [id])
}

model NotificationLog {
  id        String   @id @default(cuid())
  summary   String
  createdAt DateTime @default(now())
}
