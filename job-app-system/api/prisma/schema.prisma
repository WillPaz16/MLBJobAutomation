datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// PostingCategory (string): BASEBALL_OPS | BASEBALL_ANALYTICS | BASEBALL_RND | DATA_SCIENCE | OTHER
// ApplicationStage (string): FOUND | REVIEWING | APPLIED | INTERVIEW | OFFER | REJECTED | WITHDRAWN
// SQLite has no native enum support in Prisma, so these are validated in the API layer (zod) instead.

model Source {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String   // "greenhouse" | "lever" | "workday" | "team_page" | "manual"
  createdAt DateTime @default(now())
  postings  Posting[]
}

model Posting {
  id            String   @id @default(cuid())
  sourceId      String
  source        Source   @relation(fields: [sourceId], references: [id])
  externalId    String   // id/url fragment from the source, used for dedup
  title         String
  organization  String
  location      String?
  category      String   @default("OTHER")
  seniority     String?  // computed at ingest time, see scrapers/src/seniority.ts — "ENTRY" | "MID" | "SENIOR" | "EXECUTIVE" | null (unclassified)
  salary        String?  // raw text when a source happens to expose it (rare) — display-only, never parsed/filtered numerically
  workMode      String?  // computed at ingest time, see scrapers/src/location.ts — "REMOTE" | "HYBRID" | "ONSITE" | null (unclassified)
  region        String?  // computed at ingest time, see scrapers/src/location.ts — "USA" | "INTERNATIONAL" | null (unclassified)
  url           String
  description   String?
  postedAt      DateTime?
  discoveredAt  DateTime @default(now())
  applications  Application[]

  // Active/inactive tracking (scrapers/src/ingest.ts's closing pass, scoped per sourceId+organization
  // since one Source row is shared across every org an adapter covers).
  //
  // lastSeenAt is write-only today (never read by any query), but deliberately kept: it's the
  // diagnostic record of the last time the closing pass actually observed this row live, which
  // the v9 mass-close guard in runDiscovery.ts's runAdapter makes MORE valuable as a diagnostic,
  // not less — if that guard ever trips, this timestamp is the first thing worth checking. Do
  // not remove it in a future pruning pass on "write-only" grounds alone.
  lastSeenAt    DateTime @default(now())
  closedAt      DateTime?
  missedRuns    Int      @default(0)

  // Cross-source duplicate flagging (scrapers/src/dedupe.ts) — a fuzzy title match against an
  // existing posting from the same org is inserted as its own row and linked here rather than
  // silently skipped, so it's visible and reviewable instead of invisibly suppressed.
  possibleDuplicateOfId String?
  possibleDuplicateOf   Posting?  @relation("PostingDuplicate", fields: [possibleDuplicateOfId], references: [id], onDelete: SetNull)
  duplicateCandidates   Posting[] @relation("PostingDuplicate")
  duplicateRejected     Boolean   @default(false)

  // User-initiated "not interested" — distinct from closedAt (which tracks whether the source
  // still lists it). A dismissed posting stays dismissed even if a later scrape still finds it,
  // since dismissal reflects the user's judgment about the role, not the listing's liveness.
  dismissedAt           DateTime?

  // Computed at ingest time, see scrapers/src/categorize.ts's isMlbOrg() — whether `organization`
  // is an MLB team/org (org-name match only, not title/description).
  isMlbTeam             Boolean   @default(false)

  // Exact section header text a posting came from, when its source tracks sub-sections within
  // one adapter (currently only newGradList.ts — see sources.config.ts's newGradListConfig.sections
  // for the exact 3 values). Null for every other adapter, which has no such concept.
  sourceSection         String?

  // Computed at ingest time, see scrapers/src/internship.ts's classifyIsInternship() — title-only
  // signal (same reasoning as isMlbTeam above), kept separable from seniority (ENTRY also covers
  // non-internship new-grad roles) so internships can be filtered independently.
  isInternship          Boolean   @default(false)

  @@unique([sourceId, externalId])
  @@index([organization])
  @@index([sourceId, organization, closedAt])
}

model Application {
  id          String            @id @default(cuid())
  postingId   String
  posting     Posting           @relation(fields: [postingId], references: [id])
  stage       String            @default("FOUND")
  order       Int               @default(0) // position within its stage column, for Kanban drag-reorder
  resumeDocId String?
  resumeDoc   Document?         @relation("ResumeDoc", fields: [resumeDocId], references: [id])
  coverDocId  String?
  coverDoc    Document?         @relation("CoverDoc", fields: [coverDocId], references: [id])
  notes       String?
  appliedAt   DateTime?
  updatedAt   DateTime          @updatedAt
  createdAt   DateTime          @default(now())
  stageEvents ApplicationStageEvent[]
}

// Append-only stage-transition history — Application.stage only ever tells you the CURRENT
// stage, not when/how it got there. Written from a single choke point (the PATCH /:id handler
// in routes/applications.ts, plus the seed event from POST /postings/:id/approve) so real funnel
// analytics (routes/analytics.ts's GET /funnel) has honest data instead of being derived from
// `updatedAt` (which bumps on ANY write, not just a stage change). `source: "backfill"` marks
// events synthesized after the fact (scripts/backfillStageEvents.ts) from pre-existing
// Applications that predate this model — those are fine for reached-counts/conversion (which
// don't depend on exact timing) but must be excluded from all duration math (median/mean days in
// stage, response time), since their timestamps are copied from createdAt/updatedAt, not real
// transition times.
model ApplicationStageEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage     String?
  toStage       String
  createdAt     DateTime    @default(now())
  source        String      @default("api") // "api" | "backfill"

  @@index([applicationId, createdAt])
  @@index([toStage, createdAt])
}

model Document {
  id                    String   @id @default(cuid())
  kind                  String   // "resume" | "cover_letter"
  label                 String
  filePath              String
  isBaseTemplate        Boolean  @default(false)
  createdAt             DateTime @default(now())

  // Managed file storage (Phase 4). A document is "managed" iff storageKey != null — its bytes
  // live under api/data/documents/, copied in (never moved) from wherever they originated.
  // filePath is kept as the legacy/external-path reference; sourcePath records provenance for a
  // managed copy specifically (where it was copied from, e.g. Resumes/ or Cover Letters/).
  storageKey            String?  // basename inside api/data/documents/; null = legacy/external-path-only
  originalFilename      String?
  mimeType               String?
  sizeBytes              Int?
  sourcePath             String?
  resumeFor             Application[] @relation("ResumeDoc")
  coverFor              Application[] @relation("CoverDoc")
}

// Reusable experience bullets the tailoring skill draws from instead of inventing
// phrasing per application. `category` matches PostingCategory loosely (e.g.
// "baseball_ops", "data_science", "general") to narrow candidates for a given posting.
model ResumeBullet {
  id       String  @id @default(cuid())
  category String
  text     String
  tags     String? // comma-separated free-text tags
  isActive Boolean @default(true)
}

// Named tone/voice guidance the tailoring skill picks based on posting category or
// an OrgProfile override, instead of inferring tone from a single prior example letter.
model TonePreset {
  id        String   @id @default(cuid())
  name      String   @unique
  guidance  String   // freeform description of voice/structure to follow
  isDefault Boolean  @default(false)
  orgs      OrgProfile[]
}

// Optional per-organization memory so a second application to the same org doesn't
// start from zero — notes on culture/prior interactions, and an optional tone override.
model OrgProfile {
  id               String      @id @default(cuid())
  organizationName String      @unique
  notes            String?
  preferredToneId  String?
  preferredTone    TonePreset? @relation(fields: [preferredToneId], references: [id])
}

// Saved Discovery filter views, stored in the DB (not localStorage) per the confirmed v8 decision
// — survives browser resets and is covered by the existing nightly backup.ts, unlike
// localStorage. `query` is the exact query string useFilterParams already round-trips through
// the URL (everything except `page`, which a saved view shouldn't pin), so applying a saved
// search is just re-parsing that string back into individual setFilter calls client-side — no
// structured filter shape needs to be duplicated/kept in sync here.
model SavedSearch {
  id        String   @id @default(cuid())
  name      String
  query     String   // URLSearchParams-formatted string, e.g. "tab=baseball&minFit=40"
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NotificationLog {
  id        String   @id @default(cuid())
  summary   String
  createdAt DateTime @default(now())
}

// Singleton candidate profile used for deterministic fit scoring against postings
// (api/src/fitScore.ts). The fixed-literal @default("profile") on id makes "singleton"
// a property of the primary key rather than app-level enforcement.
model CandidateProfile {
  id                  String   @id @default("profile")
  skills              String   // comma-separated keywords, the secondary/broader match pool
  coreSkills          String?  // comma-separated keywords, higher-weight tier (see fitScore.ts)
  preferredCategories String?  // comma-separated PostingCategory values
  locationKeywords    String?  // comma-separated, small location boost
  excludeKeywords     String?  // comma-separated, dealbreaker penalty
  updatedAt           DateTime @updatedAt
}

// Singleton, real-PII identity used to prefill/apply-assist (v8 Phase 4). Deliberately a SIBLING
// of CandidateProfile, NOT an extension of it: CandidateProfile is a scoring object whose schema
// (putCandidateProfileSchema) is shared verbatim by PUT /api/profile AND
// POST /api/profile/coverage/preview — adding identity fields there would post the user's DOB to
// a scoring endpoint on every keystroke of Compatibility's live preview. Every field here is
// nullable: a partially-filled identity is the normal state, not an error state.
//
// dateOfBirth is a plain String ("YYYY-MM-DD"), never DateTime — Prisma+SQLite stores DateTime
// UTC-shifted, so "1999-03-14" would round-trip as "1999-03-13T19:00:00Z" in US timezones (an
// off-by-one birthday bug). No time component is needed and no date arithmetic ever happens on
// this field, so a plain string sidesteps the bug entirely. Same reasoning as Posting.salary
// being raw text instead of a parsed number.
//
// requiresSponsorship/authorizedToWorkUs are nullable Booleans, not booleans-with-a-default: null
// means "declined to answer", a genuinely different state from `false` that must never be
// silently coerced to false by any autofill/apply-assist consumer.
//
// EEO fields are stored as CODE + LABEL pairs (e.g. genderIdentityCode/genderIdentityLabel). The
// code drives a <Select>/option-matching logic; the label exists because the federal CC-305
// disability self-identification form has legally specific wording that differs from
// Greenhouse's own EEO dropdown wording, which differs again from Workday's — code alone would
// force a future autofill helper to guess at exact wording, label alone would allow no reliable
// option-matching.
//
// NEVER add an `ssn` field here, or any other government-ID number. If you're reading this
// because a future task seems to call for one: it doesn't. Social Security numbers are never
// stored by this system, full stop.
model ApplicantIdentity {
  id             String @id @default("identity")

  legalFirstName String?
  legalMiddleName String?
  legalLastName  String?
  preferredName  String?

  email          String?
  phone          String?

  addressStreet  String?
  addressCity    String?
  addressState   String?
  addressZip     String?
  addressCountry String?

  dateOfBirth    String? // "YYYY-MM-DD" — see model comment above, never DateTime

  requiresSponsorship Boolean? // null = declined to answer; never treat as false
  authorizedToWorkUs  Boolean? // null = declined to answer; never treat as false

  // EEO self-identification — code + label, both, per the model comment above.
  genderIdentityCode      String?
  genderIdentityLabel     String?
  raceEthnicityCode       String?
  raceEthnicityLabel      String?
  disabilityStatusCode    String?
  disabilityStatusLabel   String?
  veteranStatusCode       String?
  veteranStatusLabel      String?

  linkedinUrl    String?
  portfolioUrl   String?
  githubUrl      String?
  otherUrl       String?

  updatedAt      DateTime @updatedAt

  education      EducationEntry[]
}

// Multiple degrees are a real fact and ATS education sections repeat, so this is its own related
// model rather than embedded fields on ApplicantIdentity. isPrimary exclusivity (at most one
// EducationEntry per identity with isPrimary: true) is enforced in a transaction at the route
// layer — same "re-sequence all affected rows in one transaction" discipline CLAUDE.md documents
// for Application.order in Pipeline.tsx.
model EducationEntry {
  id                  String            @id @default(cuid())
  applicantIdentityId String
  applicantIdentity   ApplicantIdentity @relation(fields: [applicantIdentityId], references: [id], onDelete: Cascade)

  school       String?
  degree       String?
  fieldOfStudy String?
  startDate    String? // "YYYY-MM-DD" or "YYYY-MM" — String, same DateTime-avoidance reasoning as dateOfBirth above
  endDate      String?
  gpa          String?
  isPrimary    Boolean @default(false)

  @@index([applicantIdentityId])
}

// Reusable answers to recurring free-text application questions ("why do you want to work
// here", "describe a time you..."). `category` is a loose free-text tag (mirrors
// ResumeBullet.category's convention) used to narrow which snippets are suggested for a given
// application context. `template` supports {{org}}/{{role}}/{{orgNotes}} placeholders resolved
// server-side at read time (see ../src/answerTemplate.ts) — unknown placeholders are left
// verbatim in the output and reported separately, never silently blanked.
model AnswerSnippet {
  id        String   @id @default(cuid())
  category  String
  question  String   // the recurring question this answers, for matching/display
  template  String   // the answer body, may contain {{org}}/{{role}}/{{orgNotes}} placeholders
  tags      String?  // comma-separated free-text tags, same convention as ResumeBullet.tags
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  overrides AnswerOverride[]
}

// A full override of a specific application's answer to a specific question — not a tweak of an
// AnswerSnippet, a replacement. Keyed by applicationId + questionKey (a free-text identifier for
// the question, since no adapter reliably exposes an application's actual ATS question text in
// parseable form across 5+ ATS shapes). snippetId is optional: an override can exist standalone
// (no matching reusable snippet at all) or be linked to the snippet it's overriding, for display
// purposes ("overriding your usual answer to X").
model AnswerOverride {
  id            String         @id @default(cuid())
  applicationId String
  questionKey   String
  answer        String         // full override text, may also contain {{org}}/{{role}}/{{orgNotes}} placeholders
  snippetId     String?
  snippet       AnswerSnippet? @relation(fields: [snippetId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([applicationId, questionKey])
  @@index([applicationId])
}
